{
  "name": "drainage-flood-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/dev.mjs",
    "lint": "eslint .",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:coverage": "c8 --all --include=src/geometry.js --include=src/ea-adapter.js --include=src/report.js --include=src/config.js --reporter=text --reporter=lcov --reporter=json-summary --reports-dir=coverage node --test --test-isolation=none tests/*.test.js",
    "test:live": "node --test --test-isolation=none tests/live-service.smoke.js",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "leaflet-draw": "1.0.4",
    "polygon-clipping": "0.15.7",
    "proj4": "2.19.10"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "c8": "^12.0.0",
    "esbuild": "0.25.12",
    "eslint": "9.32.0"
  }
}
